name = "zeauddin-memory-api"
main = "src/index.ts"
compatibility_date = "2026-09-21"

[[d1_databases]]
binding = "DB"
database_name = "zeauddin-archive"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "zeauddin-archive-private"
